APP_NAME="WhatsApp Bulk"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://whatsappbulk.nooryak.com
APP_INSTALLED=true
STANDALONE_MODE=true

SITE_TITLE="WhatsApp Bulk & Automation"
SITE_DESCRIPTION="WhatsApp Automation, Bulk Messaging, Chatbot & Marketing Platform."
SITE_KEYWORDS="WhatsApp automation, bulk messaging, chatbot, CRM"

THEMES_DIR=resources/themes
THEME_FRONTEND=waziper
DEMO_MODE=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DB_NAME
DB_DATABASE_MAIN=CHANGE_ME_DB_NAME
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

WHATSAPP_SERVER_URL=http://127.0.0.1:8000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_UPI_ID=

SESSION_DRIVER=file
SESSION_LIFETIME=12000
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
CACHE_PREFIX=wabulk_

MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=CHANGE_ME_MAIL_PASS
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="WhatsApp Bulk"